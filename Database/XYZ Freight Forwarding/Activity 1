CREATE DATABASE XYZ_Freight_Forwarding;
USE XYZ_Freight_Forwarding;

SHOW DATABASES;
USE XYZ_Freight_Forwarding;
SELECT DATABASE();
SHOW TABLES;

CREATE TABLE customer (
    cust_number VARCHAR(10) PRIMARY KEY NOT NULL,
    cust_name VARCHAR(100) NOT NULL,
    addr VARCHAR(150),
    city VARCHAR(50),
    state VARCHAR(50),
    postcode VARCHAR(10),
    contact_no VARCHAR(15)
);

CREATE TABLE product (
    prod_code VARCHAR(10) PRIMARY KEY NOT NULL,
    prod_desc VARCHAR(100) NOT NULL,
    unit VARCHAR(20),
    sales_price DECIMAL(10,2) NOT NULL,
    CHECK (sales_price >= 0)
);
-- TASK 2
CREATE TABLE invoice ( 
inv_number VARCHAR(10) PRIMARY KEY NOT NULL, 
inv_date DATE NOT NULL, 
cust_number VARCHAR(10) NOT NULL, 
inv_amount DECIMAL(10,2) NOT NULL, 
shipped_by VARCHAR(50), 
ship_trackingno VARCHAR(30),

FOREIGN KEY (cust_number)
REFERENCES Customer(cust_number)
ON UPDATE CASCADE
ON DELETE RESTRICT,

CHECK (inv_amount >= 0)
);

CREATE TABLE invoice_line ( 
inv_number VARCHAR(10), 
prod_code VARCHAR(10), 
quantity INT NOT NULL, 
sales_price DECIMAL(10,2) NOT NULL, 
total_sales DECIMAL(10,2) NOT NULL,
PRIMARY KEY (inv_number, prod_code),

FOREIGN KEY (inv_number)
REFERENCES Invoice(inv_number)
ON UPDATE CASCADE
ON DELETE CASCADE,

FOREIGN KEY (prod_code)
REFERENCES Product(prod_code)
ON UPDATE CASCADE
ON DELETE RESTRICT,

CHECK (quantity > 0),
CHECK (sales_price >= 0),
CHECK (total_sales >= 0)
);
