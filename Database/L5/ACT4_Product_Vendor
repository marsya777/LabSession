-- Q3
SELECT DISTINCT a.prcode, a.prpricing, a.prvendor
FROM prodvendor a
JOIN prodvendor b
  ON a.prcode = b.prcode
 AND a.prvendor <> b.prvendor
ORDER BY a.prcode;
